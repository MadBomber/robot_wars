source "https://rubygems.org"

# Specify your gem's dependencies in robot_wars.gemspec
gemspec

gem "bundler-audit"
gem "fasterer"
gem "flay"
gem "flog"
gem "irb"
gem "racc"
gem "rake", "~> 13.0"
gem "reek"
gem "rubocop"

gem "minitest", "~> 5.16"
gem "simplecov", require: false

gem "ractor_queue"

# Develop against the sibling robot_lab checkout in this project.
gem "robot_lab", path: "../robot_lab"
