#!/usr/bin/env ruby
# rwars — run a RobotWars match with LLM-backed warriors.
#
#   rwars                                   # the gem's example warriors
#   rwars --warriors ./warriors --size 10x10
#
# Each warrior is one *.md prompt template (RobotLab's format: YAML
# front matter + a personality body) in the warriors directory — the
# gem's shipped examples/warriors unless --warriors says otherwise.
# The filename (minus ".md") becomes that warrior's id. Files starting
# with "_" are never warriors: they are shared partials, or the
# shipped _announcer.md default brain for --announcer.
#
# The rules of the game are NOT the templates' job: every robot gets
# the gem's own canonical recap (RobotWars::GameRules, shipped as
# lib/robot_wars/game_rules.md) as its RobotLab system_prompt.

repo_root = File.expand_path("..", __dir__)
ENV["BUNDLE_GEMFILE"] = File.expand_path(ENV["BUNDLE_GEMFILE"] || "Gemfile.local", repo_root)
require "bundler/setup"

require "optparse"
require "robot_wars"

# The transcript is watched live (and each turn can stall for seconds
# on pilot LLM calls), so lines must land the moment they're printed —
# even when stdout is a pipe or a file, where Ruby would otherwise
# block-buffer whole turns.
$stdout.sync = true

# Each warrior's own *.md front matter picks its brain: the `model:`
# field is "<provider>/<model id>" (e.g. apfel/apple-foundationmodel),
# parsed by RobotWars::ModelSpec. --model, in the same format, forces
# every warrior onto the same one. Nothing here names a provider or
# model of its own — a template that names neither falls through to
# RobotLab's config cascade.
# The gem's own examples ship with it, so they make a working default
# for both the warrior roster and the announcer's brain.
default_warriors  = File.join(repo_root, "examples", "warriors")
default_announcer = File.join(default_warriors, "_announcer.md")

options = { warriors: default_warriors, width: 10, height: 10, max_turns: 500, seed: nil,
            model: nil, life: RobotWars::Robot::STARTING_LIFE, timeout: 60.0, announcer: nil,
            browser: nil }

warriors_help  = "Directory of *.md warrior brain templates (default: the gem's examples/warriors)"
browser_help   = "Watch the match live in a web browser: board, territory, life, and play-by-play " \
                 "update every turn. PORT fixes the spectator server's port (default: an OS-assigned free port)"
timeout_help   = "Seconds a pilot may take to answer each turn before it is declared brain dead " \
                 "and its robot removed from the match (default: #{options[:timeout].to_i})"
announcer_help = "Add a radio play-by-play announcer who speaks each turn aloud through the " \
                 "platform's text-to-speech (macOS say, Windows System.Speech, Linux spd-say/espeak). " \
                 "FILE is your own announcer brain template " \
                 "(default: the gem's examples/warriors/_announcer.md)"

parser = OptionParser.new do |opts|
  opts.banner = "Usage: rwars [options]"

  opts.on("-w", "--warriors DIR", warriors_help) { |dir| options[:warriors] = dir }
  opts.on("--width N", Integer, "Board width (default: #{options[:width]})") { |n| options[:width] = n }
  opts.on("--height N", Integer, "Board height (default: #{options[:height]})") { |n| options[:height] = n }
  opts.on("--size WxH", "Board size shorthand, e.g. 12x12 (overrides --width/--height)") do |size|
    options[:width], options[:height] = size.split(/x/i, 2).map(&:to_i)
  end
  opts.on("--max-turns N", Integer, "Stop after N turns if nobody has won yet (default: #{options[:max_turns]})") do |n|
    options[:max_turns] = n
  end
  opts.on("--seed N", Integer, "Seed the random number generator for a reproducible match") { |n| options[:seed] = n }
  opts.on("--life N", Integer, "Starting life for every robot (default: #{options[:life]})") { |n| options[:life] = n }
  opts.on("--model PROVIDER/MODEL", "Force every warrior onto this model, overriding its own front matter") { |m| options[:model] = m }
  opts.on("--timeout SECONDS", Float, timeout_help) { |secs| options[:timeout] = secs }
  opts.on("--announcer [FILE]", announcer_help) { |file| options[:announcer] = File.expand_path(file || default_announcer) }
  opts.on("--browser [PORT]", Integer, browser_help) { |port| options[:browser] = port || 0 }
  opts.on("--version", "Show the robot_wars gem version") do
    puts "rwars #{RobotWars::VERSION}"
    exit
  end
  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit
  end
end

parser.parse!(ARGV)

abort "error: --life must be positive; got #{options[:life]}" unless options[:life].positive?
abort "error: --timeout must be positive; got #{options[:timeout]}" unless options[:timeout].positive?
if options[:browser] && !options[:browser].between?(0, 65_535)
  abort "error: --browser PORT must be 0-65535; got #{options[:browser]}"
end

warriors_dir = File.expand_path(options[:warriors])
abort "error: #{warriors_dir} is not a directory" unless File.directory?(warriors_dir)

brain_files = Dir.glob(File.join(warriors_dir, "*.md")).reject { |path| File.basename(path).start_with?("_") }
abort "error: no *.md files found in #{warriors_dir}" if brain_files.empty?
abort "error: need at least 2 warriors to fight; found #{brain_files.size}" if brain_files.size < 2

if options[:announcer] && !File.file?(options[:announcer])
  abort "error: announcer brain template #{options[:announcer]} does not exist"
end

# Setting PM.configure directly here would be overwritten the moment
# RobotLab.config is first touched (lazily, inside RobotLab::Robot#new) —
# it reapplies its own default prompts_dir. Going through RobotLab's own
# config makes our setting durable against that lazy reload. Quieting
# ruby_llm's default :debug logging the same way, since a game shouldn't
# dump every raw API request/response to stdout by default.
RobotLab.config.template_path = warriors_dir
RobotLab.config.ruby_llm.log_level = :warn
RobotLab.config.after_load

random       = options[:seed] ? Random.new(options[:seed]) : Random.new
board        = RobotWars::Board.new(width: options[:width], height: options[:height])
warrior_ids  = brain_files.map { |path| File.basename(path, ".md") }
game         = RobotWars::Game.start(board: board, robot_ids: warrior_ids, life: options[:life], random: random)

# The browser spectator (phase 2): serve the page shell from a
# background thread, open it in the default browser, and push one
# update over SSE per resolved turn — the re-rendered board (icons,
# life numbers, territory shading), legend, and the play-by-play log.
# Every update is built HERE on the match thread (the only thread that
# may read game state) and handed to the server as a frozen JSON
# string, so serving never races the match loop. `roster` keeps the
# original lineup: legend rows outlive their robots (dimmed) and
# colors stay stable as warriors die.
roster        = game.robots
spectator     = nil
spectator_log = []
if options[:browser]
  page = RobotWars::SpectatorPage.new(game: game, roster: roster)
  begin
    spectator = RobotWars::SpectatorServer.new(html: page.to_html, port: options[:browser]).start
  rescue SystemCallError => e
    abort "error: could not start the spectator server on port #{options[:browser]} (#{e.message})"
  end
  puts "spectator view: #{spectator.url}"
  RobotWars::BrowserOpener.new.call(spectator.url) || puts("could not launch a browser — open #{spectator.url} yourself")
end

broadcast = lambda do |report: nil, final: false|
  next unless spectator

  update = RobotWars::SpectatorUpdate.new(game: game, roster: roster, log_lines: spectator_log,
                                          events: report ? report.events : [], final: final)
  spectator.publish(update.to_json)
end

# Resolve each warrior's "<provider>/<model id>" up front: --model wins
# over front matter, front matter over nothing. RobotLab would otherwise
# hand the front matter's combined string to RubyLLM verbatim as a model
# id, so the split into provider + bare model must happen here.
override = RobotWars::ModelSpec.parse(options[:model])
specs = game.robots.to_h do |robot|
  [robot, override || RobotWars::ModelSpec.from_template(File.join(warriors_dir, "#{robot.id}.md"))]
end
# The announcer's brain file can live anywhere, so it can't go through
# prompt_manager's single template directory (pinned to the warriors
# above) — parse it directly: front matter picks model and temperature
# (naming no model falls through to RobotLab's config cascade), and the
# body is the persona.
announcer_brain = options[:announcer] && RobotWars::PromptTemplate.load(options[:announcer])
announcer_spec  = announcer_brain && announcer_brain.model_spec

# Providers that live outside ruby_llm itself (apfel, lms, ...) ship as
# ruby_llm-providers-<name> gems and register themselves when required;
# built-in providers are already in the registry and need nothing.
(specs.values + [announcer_spec]).compact.map(&:provider).compact.uniq.each do |provider|
  next if RubyLLM::Provider.providers.key?(provider)

  begin
    require "ruby_llm/providers/#{provider}"
  rescue LoadError
    abort "error: unknown provider #{provider.inspect} — not built into ruby_llm " \
          "and no ruby_llm/providers/#{provider} library could be loaded"
  end
end

warriors = game.robots.to_h do |robot|
  # Constructor kwargs beat front matter, which is what makes the parsed
  # bare model id (and --model's universal override) win over the raw
  # "<provider>/<model>" string still sitting in the template.
  build_options = { name: robot.id, template: robot.id.to_sym,
                    system_prompt: RobotWars::GameRules.text }
  if (spec = specs.fetch(robot))
    build_options[:model]    = spec.model
    build_options[:provider] = spec.provider if spec.provider
  end

  llm_robot = RobotLab.build(**build_options)
  [robot, RobotWars::Warrior.new(robot: robot, pilot: RobotWars::LLMPilot.new(llm_robot: llm_robot))]
end

# The announcer is not a combatant: no sensing reports, never in the
# roster — its persona is its brain template's body and its message is
# each turn's printed recap. Its RobotLab chat keeps history, so the
# commentary can carry rivalries and momentum across turns. The Booth
# runs it on its own thread: the match plays at pilot speed while the
# commentary happens concurrently, and a booth that falls behind
# catches up by calling several queued turns in one breath.
booth = nil
if announcer_brain
  build_announcer = { name: "announcer", system_prompt: announcer_brain.body }
  build_announcer[:temperature] = announcer_brain.temperature if announcer_brain.temperature
  if announcer_spec
    build_announcer[:model]    = announcer_spec.model
    build_announcer[:provider] = announcer_spec.provider if announcer_spec.provider
  end
  booth = RobotWars::Booth.new(announcer: RobotWars::Announcer.new(llm_robot: RobotLab.build(**build_announcer)))
end

header = <<~HEADER
  RobotWars — #{warrior_ids.size} warriors on a #{board.width}x#{board.height} board
  warriors: #{warrior_ids.join(', ')}
HEADER
puts header
spectator_log.concat(header.lines.map(&:chomp))
broadcast.call
booth&.announce(header)

last_report = nil
until game.over? || game.turn_number >= options[:max_turns]
  # Every pilot's prompt goes out concurrently — the calls are
  # I/O-bound waits, so a turn costs the slowest brain rather than the
  # sum of all of them. Sensing reports are built up front on the main
  # thread (they read shared game state); each thread then only talks
  # to its own warrior's chat. Battleship-style: an attacker is told on
  # its NEXT turn whether last turn's shot found a robot (HIT) or an
  # empty square (MISS).
  threads = game.alive_robots.to_h do |robot|
    sensing = RobotWars::SensingReport.new(
      game: game, robot: robot,
      attack_outcome: last_report&.attack_outcome_for(robot)
    ).to_s

    thread = Thread.new do
      # A brain failure is reported once, by the abort below — not as a
      # raw stack trace the moment the thread dies.
      Thread.current.report_on_exception = false
      warriors.fetch(robot).decide(sensing)
    end
    [robot, thread]
  end

  # One shared deadline for the whole volley: a pilot that hasn't
  # answered by then is brain dead (rule 45) — its robot is removed
  # from the match instead of hanging everyone. Thread#value re-raises
  # a failed brain's exception, preserving the serial loop's abort
  # behavior for real errors.
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + options[:timeout]
  actions = {}
  threads.each do |robot, thread|
    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    if thread.join([remaining, 0].max)
      begin
        actions[robot] = thread.value
      rescue StandardError => e
        abort "error: #{robot.id}'s brain failed to respond (#{e.class}: #{e.message})"
      end
    else
      thread.kill
      game.remove_robot(robot)
      obituary = "#{robot.id} is brain dead (no reply within #{options[:timeout]}s) — removed from the match"
      puts obituary
      spectator_log << obituary
      broadcast.call
      booth&.announce(obituary)
    end
  end
  next if game.over?

  report = game.play_turn(actions)
  # The turn's story is the Report's own event stream, narrated by the
  # one shared TurnNarrator — the browser's play-by-play panel shows
  # these exact lines, so the two spectators can never disagree.
  recap = ["turn #{game.turn_number}: #{game.alive_robots.map { |r| "#{r.id}=#{r.life}" }.join(', ')}"]
  RobotWars::TurnNarrator.new(report: report).lines.each { |line| recap << "  #{line}" }
  puts recap
  spectator_log.concat(recap)
  broadcast.call(report: report)
  booth&.announce(recap.join("\n"))
  last_report = report
end

finale = if game.tie?
           "Tie — the last warriors fell in the same turn."
         elsif game.over?
           "Winner: #{game.winner.id} (#{game.winner.life} life) after #{game.turn_number} turns."
         else
           "Stopped after #{game.turn_number} turns (max-turns reached) — #{game.alive_robots.size} warriors still standing."
         end
puts "---"
puts finale
spectator_log << "---" << finale
broadcast.call(final: true)
booth&.announce(finale)
# Drain both broadcasters before the process goes away: every
# spectator gets the final update (the finished page stays on screen
# in the browser), and the booth finishes calling the match.
spectator&.stop
booth&.close
